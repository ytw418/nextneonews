{
  "name": "@kmedia/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv run -q -f ../../.env -- next dev",
    "build": "dotenv run -q -f ../../.env -- next build",
    "start": "dotenv run -q -f ../../.env -- next start",
    "lint": "eslint . && node scripts/lint-tokens.mjs",
    "lint:tokens": "node scripts/lint-tokens.mjs --strict",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@kmedia/core": "*",
    "@kmedia/db": "*",
    "budoux": "^0.9.3",
    "next": "16.4.1",
    "next-intl": "^4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^18.0.8",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4.3.3"
  }
}
