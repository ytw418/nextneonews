// 데이터 모델은 docs/PRD.md 7장을 따른다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RiskTier {
  GREEN // 자동 발행
  YELLOW // 사람 승인
  RED // 쓰지 않음
}

enum Category {
  KPOP
  KENT // 연예인 근황·열애·결혼 등 (작품과 무관한 셀럽 소식)
  KDRAMA
  KFOOD
  KBEAUTY // 한국 화장품·올리브영
  TRAVEL
  STUDY // 한국 유학·어학당·장학금
  LOVE // 한국인과 연애·국제결혼
  WORKING_HOLIDAY
  JOBS
  HOUSING
  LIFE
}

enum ArticleFormat {
  ISSUE
  REACTION
  QNA
  GUIDE
  LIST
}

enum TopicStatus {
  NEW
  QUEUED
  WRITING
  DONE
  SKIPPED
}

enum ArticleStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  REJECTED
}

enum SourceKind {
  OFFICIAL
  NEWS
  COMMUNITY
}

enum MediaKind {
  EMBED
  AGENCY
  PRESS
  CARD
  AI
  STOCK
  OWN
}

enum CommentStatus {
  VISIBLE
  PENDING
  HIDDEN
}

enum SocialMode {
  API
  PACK
}

enum PostStatus {
  QUEUED
  POSTED
  FAILED
}

enum CostKind {
  LLM
  IMAGE
  TTS
  API
}

// 수집 원장: 제목·링크·숫자만 저장한다. 같은 글은 (source, externalId)로 갱신한다.
model Signal {
  id           String    @id @default(cuid())
  source       String // "pann", "naver-entertain" ...
  externalId   String // 소스 안에서의 글 번호 등
  title        String
  url          String
  lang         String    @default("ko")
  metrics      Json // { views, comments, likes, rank }
  // 질문·이슈 품질 체크 결과 (규칙 필터 + LLM 채점). null 이면 아직 안 봄
  qualityScore Float?
  qualityNote  String?
  checkedAt    DateTime?
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  topicId      String?
  topic        Topic?    @relation(fields: [topicId], references: [id])

  @@unique([source, externalId])
  @@index([lastSeenAt])
}

model Topic {
  id         String         @id @default(cuid())
  keyword    String
  score      Float          @default(0)
  riskTier   RiskTier       @default(YELLOW)
  status     TopicStatus    @default(NEW)
  // 품질 체크(AI 채점)가 정한 값. 글 작성 단계가 그대로 쓴다
  category   Category?
  format     ArticleFormat?
  locales    String[] // 특히 먹힐 언어권
  brief      String? // 채점 이유 한 줄
  // 가이드 주제 (docs/research/topics-2026-10.md): 영어 제목 방향과 사실을 가져올 공식 페이지
  angle      String?
  factUrls   String[]       @default([])
  imageQuery String? // 대표 사진 검색어 (위키미디어 공용, 사람이 정한 것만)
  createdAt  DateTime       @default(now())
  signals    Signal[]
  articles   Article[]
}

model Article {
  id               String         @id @default(cuid())
  topicId          String?
  topic            Topic?         @relation(fields: [topicId], references: [id])
  category         Category
  format           ArticleFormat
  riskTier         RiskTier
  status           ArticleStatus  @default(DRAFT)
  facts            Json? // 출처에서 뽑은 사실 목록 (숫자는 여기 값만 쓴다)
  entities         Json? // 등장 인물·그룹·작품 [{ name, type, koreanName, alternateNames }] → JSON-LD about (GEO)
  publishedAt      DateTime?
  views            Int            @default(0) // 기사 페이지 조회 수 (모든 언어 합). 인기·추천 글에 쓴다
  reactions        Json           @default("{}") // 반응 버튼 수 { love, wow, more, sad } (ReactionVote 합)
  // 커뮤니티 반응 요약용 숫자 { sourceUrl, commentCount, sampled, mix: { support, funny, critical, neutral }, at }. 원문 글·이미지는 저장하지 않는다
  netizen          Json?
  // 제목·본문이 바뀔 때만 갱신한다 (updatedAt 은 조회 수 때문에 계속 바뀐다). sitemap lastmod·dateModified 에 쓴다
  contentUpdatedAt DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  translations     Translation[]
  sources          SourceRef[]
  media            Media[]
  comments         Comment[]
  videos           Video[]
  socialPosts      SocialPost[]
  poll             Poll?
  reactionVotes    ReactionVote[]

  @@index([status, publishedAt])
  @@index([status, views])
}

model Translation {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  locale    String // "en" | "ja" | "zh-TW" | "ko"
  slug      String
  title     String
  summary   String
  body      String // markdown
  faq       Json? // [{ q, a }]
  keyPoints Json? // 핵심 요약 3줄 (AI 답변·검색 스니펫이 인용하기 좋게)
  seoTitle  String?
  seoDesc   String?
  indexable Boolean @default(true) // 품질 낮은 번역은 noindex
  poll      Json? // 이 언어의 투표 문구 { question, options: [string] }. 보기 순서는 Poll.optionIds 와 같다
  netizen   Json? // 커뮤니티 반응 요약 { summary, quotes: [string] } (짧은 인용 2개까지)

  @@unique([articleId, locale])
  @@unique([locale, slug])
}

model SourceRef {
  id        String     @id @default(cuid())
  articleId String
  article   Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  url       String
  publisher String
  kind      SourceKind
}

model Media {
  id          String    @id @default(cuid())
  articleId   String
  article     Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  url         String
  kind        MediaKind
  credit      String? // 한 줄 표기 (예전 방식)
  // CC 라이선스 표시 조건: 저작자·라이선스 이름과 링크·원본 링크·수정 여부
  author      String?
  licenseName String?
  licenseUrl  String?
  sourceUrl   String? // 위키미디어 공용 파일 페이지
  width       Int? // 원본 크기 (CLS 없이 자리를 잡고, 구조화 데이터 image 에 넣는다)
  height      Int?
}

model Comment {
  id             String          @id @default(cuid())
  articleId      String
  article        Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  locale         String
  nickname       String // 표시용 "ㅇㅇ(7f3a)"
  idHash         String // HMAC(IP, 비밀키 + 글 ID) 앞 4자리
  ipHash         String? // HMAC(IP, 비밀키). 글과 상관없이 같은 사람의 도배를 막는 데만 쓴다
  passwordHash   String // argon2id
  body           String
  reports        CommentReport[]
  status         CommentStatus   @default(VISIBLE)
  reportCount    Int             @default(0) // 서로 다른 신고자 수 (CommentReport)
  failedAttempts Int             @default(0) // 비밀번호 연속 실패. 5번이면 잠근다
  lockedUntil    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([articleId, createdAt])
  @@index([ipHash, createdAt])
}

// 같은 사람이 같은 댓글을 여러 번 신고해도 한 번으로 센다
model CommentReport {
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  ipHash    String
  createdAt DateTime @default(now())

  @@id([commentId, ipHash])
  @@index([ipHash, createdAt])
}

model Video {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  locale    String
  format    String
  script    String
  ttsUrl    String?
  videoUrl  String?
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
}

model SocialPost {
  id          String     @id @default(cuid())
  articleId   String?
  article     Article?   @relation(fields: [articleId], references: [id], onDelete: SetNull)
  videoId     String?
  platform    String // "youtube" | "instagram" | "threads" | "x" | "tiktok" | "xiaohongshu" ...
  locale      String
  mode        SocialMode
  status      PostStatus @default(QUEUED)
  externalId  String?
  error       String?
  metrics     Json?
  scheduledAt DateTime?
  postedAt    DateTime?
}

model CostLog {
  id        String   @id @default(cuid())
  kind      CostKind
  amountUsd Decimal  @db.Decimal(10, 4)
  ref       String?
  createdAt DateTime @default(now())
}

// GEO 측정: 목표 질문을 AI 웹 검색 답변에 던졌을 때 어떤 출처가 인용되는지 (docs/geo.md)
model GeoCheck {
  id              String   @id @default(cuid())
  question        String
  locale          String
  engine          String // "claude-web-search" 등
  ourCited        Boolean // 우리 도메인이 답변 인용에 들어갔는지
  citedUrls       String[]
  citedDomains    String[]
  searchedDomains String[] // 검색은 됐지만 인용되지 않은 것 포함
  answerExcerpt   String?
  createdAt       DateTime @default(now())

  @@index([question, createdAt])
}

// 위키데이터에서 받은 인물·그룹·드라마 사전 (무료). 품질 체크(해외 인지도), 이름 표기, 대표 사진에 쓴다
model Entity {
  id         String   @id // 위키데이터 Q-id
  type       String // "group" | "singer" | "actor" | "series"
  ko         String?
  en         String?
  ja         String?
  zhHant     String?
  aliases    String[] @default([]) // 한국어 별칭 (예: "제니 김" 의 "제니"). 기사 속 이름 찾기에 쓴다
  sitelinks  Int // 이 항목이 있는 위키백과 언어 수 = 해외 인지도 지표
  image      String? // 위키미디어 공용 파일 이름 (P18)
  slug       String?  @unique // 인물 페이지 주소 /idol/{slug} (영문 이름 kebab, 없으면 q{id})
  // 대표 사진 CC 표기 { author, licenseName, licenseUrl, sourceUrl, width, height } (Commons API)
  imageMeta  Json?
  wikiTitles Json? // 언어별 위키백과 문서 제목 { ko, en, ja, zh, vi, id, fr, ru } → 조회수 수집
  updatedAt  DateTime @updatedAt

  @@index([ko])
  @@index([en])
}

// Anthropic 배치 API 작업 (50% 할인, 보통 1시간 안에 끝난다). 다음 실행 때 결과를 거둔다
model AiBatch {
  id          String    @id // Anthropic batch id (msgbatch_...)
  kind        String // "translate"
  items       Json // 요청 custom_id 목록 ["<articleId>_<locale>", ...]
  status      String    @default("in_progress") // in_progress | collected
  reservedUsd Float     @default(0) // 보낼 때 잡아 둔 최악의 비용. 거두기 전까지 예산에 넣는다
  createdAt   DateTime  @default(now())
  collectedAt DateTime?

  @@index([kind, status])
}

// K-쇼핑 주간 랭킹용 상품 (편의점 신상·올리브영 등). 이름은 매장에서 찾을 수 있게 원문 그대로 두고 번역은 따로 둔다
model Product {
  id          String   @id // "<source>:<상품 번호>"
  source      String // "cu" | "gs25" | "oliveyoung"
  name        String
  names       Json? // { en, ja, "zh-TW", ... } 배치 번역
  price       Int?
  imageUrl    String?
  url         String? // 공식 상품 페이지
  category    String? // 매장 분류 (간편식사·과자·음료 등)
  tags        String[] @default([]) // new · best · 1+1 · 2+1
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([source, firstSeenAt])
}

// 로그인 없는 투표. 글마다 하나(kind article) 또는 주간 팬 투표(kind weekly). 문구는 Translation.poll(글) 이나 labels(주간)에 있다
model Poll {
  id        String     @id @default(cuid())
  kind      String // "article" | "weekly"
  articleId String?    @unique
  article   Article?   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  key       String?    @unique // 주간 투표 "weekly:2026-w42"
  optionIds String[] // ["a", "b", "c"]. 언어마다 문구가 달라도 표는 이 id 로 모은다
  entityIds String[]   @default([]) // 보기가 인물이면 Entity.id (주간 투표)
  labels    Json? // 주간 전용 { [locale]: { question, options: [string] } }
  totals    Json       @default("{}") // { [optionId]: 표 수 }
  total     Int        @default(0)
  status    String     @default("open") // "open" | "closed"
  closesAt  DateTime?
  createdAt DateTime   @default(now())
  votes     PollVote[]
}

// 한 기기(voterHash) 한 표. IP 는 저장하지 않고 도배 제한용 해시만 둔다
model PollVote {
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    String
  voterHash String
  ipHash    String
  locale    String // 언어별 결과 비교용
  country   String? // x-vercel-ip-country
  createdAt DateTime @default(now())

  @@id([pollId, voterHash])
  @@index([pollId, locale, option])
  @@index([ipHash, createdAt])
}

// 글 반응 버튼 (love·wow·more·sad). 한 기기가 종류마다 한 번
model ReactionVote {
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  type      String // "love" | "wow" | "more" | "sad"
  voterHash String
  ipHash    String
  createdAt DateTime @default(now())

  @@id([articleId, voterHash, type])
  @@index([ipHash, createdAt])
}

// 랭킹 응원: 한 기기가 인물마다 하루(KST) 한 번.
// entityId 는 외래 키로 묶지 않는다 — 인물 사전 갱신(entities)이 빠진 항목을 지워도 응원 기록은 남긴다
model CheerVote {
  entityId  String // Entity.id (위키데이터 Q-id)
  day       String // KST "YYYY-MM-DD"
  voterHash String
  ipHash    String
  locale    String
  country   String?
  createdAt DateTime @default(now())

  @@id([entityId, day, voterHash])
  @@index([day, entityId])
  @@index([ipHash, createdAt])
}

// 로그인 없는 항목 평가·관심 투표·별점 (뷰티 제품·시술·드라마 공용). 한 기기(voterHash)가 항목마다 한 번, 바꾸면 덮어쓴다.
// itemId 는 정적 카탈로그 slug 라 외래 키가 없다. IP 는 저장하지 않는다
model ItemVote {
  kind      String // "beauty" | "clinic" | "drama"
  itemId    String // 카탈로그 slug
  choice    String // beauty: love|ok|meh · clinic: curious|done|pass · drama: 1|2|3|4|5
  facet     String? // beauty 만: 피부 타입 dry|oily|combination|sensitive|normal
  voterHash String
  ipHash    String
  locale    String
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([kind, itemId, voterHash])
  @@index([kind, itemId, choice])
  @@index([ipHash, createdAt])
}

// 랭킹 재료: 인물별 하루 숫자. 같은 날 다시 계산하면 덮어쓴다 (entityId 는 CheerVote 와 같은 이유로 외래 키 없음)
model EntityMetric {
  entityId String
  date     DateTime @db.Date // KST 날짜
  source   String // "theqoo:posts" | "theqoo:views" | "theqoo:comments" | "trends" | "yonhap" | "wiki:ja" …
  value    Float
  extra    Json?

  @@id([entityId, date, source])
  @@index([source, date])
}

// 발행한 랭킹. 매일판(period "YYYY-MM-DD")과 주간 고정판("YYYY-Www")을 남긴다. 발행 뒤에는 items 를 고치지 않고 correction 만 쓴다
model RankingSnapshot {
  id          String   @id @default(cuid())
  chart       String // "kpop" | "actors" | "kdrama" | "fan-pick"
  scope       String // "all" | 위키 언어 "ko" | "en" | "ja" | "zh" | "vi" | "id" | "fr" | "ru"
  period      String
  items       Json // RankingItem[] (packages/core/src/rankings.ts)
  sources     Json // [{ name, url, count? }] 출처 표기
  method      String // 점수 계산 방식 버전 ("v1")
  publishedAt DateTime @default(now())
  correction  String? // 발행 뒤 정정 안내

  @@unique([chart, scope, period])
  @@index([chart, scope, publishedAt])
}
