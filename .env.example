# 모든 앱(web, worker, db)이 레포 루트의 .env 하나를 읽는다.
# 로컬: `npm run db:start` 가 출력하는 주소를 그대로 쓴다.
DATABASE_URL="postgresql://postgres@localhost:54329/kmedia"

# 사이트 기본 URL (sitemap, canonical, hreflang)
SITE_URL="http://localhost:3000"

# 글 끝 '정정 요청하기' 메일 주소 (선택). 비워 두면 링크를 띄우지 않는다
NEXT_PUBLIC_CONTACT_EMAIL=""

# 익명 댓글 닉네임 해시용 비밀키 (아무 긴 랜덤 문자열)
COMMENT_HASH_SECRET="change-me"

# 다음 단계(글 작성 파이프라인)에서 사용
ANTHROPIC_API_KEY=""

# AI 비용 총 상한 (원). 넘으면 AI 호출을 막는다. 콘솔 지출 한도도 같이 걸 것
LLM_BUDGET_KRW=100000

# IndexNow 키 (8~128자 영숫자). 새 글 승인 시 Bing 등에 URL 을 바로 알린다. 운영 도메인에서만 동작
INDEXNOW_KEY=""

# false 로 두면 사람 승인 후 발행 (worker publish)
AUTO_PUBLISH=true

# ── 가이드·수익 (docs/monetize/PLAN.md §9) ──
# 제휴 추적 값: 파트너 대시보드에서 받은 그대로 붙여 넣는다 (apps/web/src/lib/affiliate.ts).
#  - {url} 이 들어간 딥링크 템플릿이면 원 주소를 인코딩해 끼운다 (Involve·Awin·Impact)  예) https://invol.co/aff_m?offer_id=1&aff_id=2&url={url}
#  - ? 로 시작하면 원 주소 쿼리에 합친다 (Amazon ?tag=xxx-20, Creatrip ?utm_source=코드)
#  - 비워 두면 보통 링크로 나간다 (상자의 '광고' 표시·고지 문장은 그대로)
AFFILIATE_OLIVEYOUNG=""
AFFILIATE_YESSTYLE=""
# 아마존은 /disclosure 의 Associates 필수 문장이 배포된 뒤에 태그를 넣는다 (미국 독자에게만 보인다)
AFFILIATE_AMAZON=""
AFFILIATE_KLOOK=""
AFFILIATE_CREATRIP=""
AFFILIATE_TRIP=""
AFFILIATE_AIRALO=""

# 애드센스 가이드 섹션 광고 단위 id (숫자). 줄째 빼 두면 글 광고 단위(NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE)를 같이 쓴다.
# 빈 문자열("")로 두면 '값이 있음'으로 읽혀 가이드 광고 칸이 비므로, 받기 전에는 주석으로 둔다
# NEXT_PUBLIC_ADSENSE_SLOT_GUIDE="1234567890"

# 드라마 허브 '한국에서 지금 듣는 노래'(애플 뮤직 RSS) 레일. 이용 조건을 확인하기 전까지 기본 꺼짐 — on 일 때만 켠다
KPOP_CHART=""
